import TelegramBot from 'node-telegram-bot-api';

export const notifyOwner = async (order_id,user_name,restaurant_name,phone,address,orderData) => {
    try{

		const itemsMessage = orderData.orderItems
  .map(item => `${item.name} x ${item.quantity} - ₹${item.price}`)
  .join("\n");
		
        const notificationMessage =  `
            ✨ *📥 New Order Received!* ✨
            \-----------------------------
            🆔 *Order items:* \`${itemsMessage}\`
            📌 *Status:* ${orderData.order_status}
            💳 *Payment Method:* ${orderData.payment_method}
            💰 *Total Amount:* \$${orderData.total_amount}

            🏪 *Restaurant Details:*
            🍽 *Name:* ${restaurant_name}

            👤 *Customer Details:*
            👤 *Name:* ${user_name}
            📞 *Contact:* ${phone}
            📍 *Address:* ${address}`.trim();
        const bot = new TelegramBot(process.env.TELEGRAM_BOT_TOKEN, { polling: false });

        let options = {
            parse_mode: 'Markdown',
            disable_web_page_preview: true
        }
        await bot.sendMessage(process.env.CHAT_ID, notificationMessage, options);
        
    }
    catch(error){
        console.error('Error notifying owner:', error);
    }
}
